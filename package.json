    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "highlight.js": "^11.9.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "marked": "^11.1.1",
    "multer": "^1.4.5-lts.1",
    "socket.io": "^4.7.4",
